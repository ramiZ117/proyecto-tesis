# Copia este archivo como `.env` (está en .gitignore) y ajusta los valores.
# Sin `.env` el proyecto arranca en modo desarrollo.

# 1 = desarrollo, 0 = producción (el equipo del restaurante)
DJANGO_DEBUG=1
# Obligatoria cuando DJANGO_DEBUG=0. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Nombres o IP con los que las estaciones entran al sistema, separados por coma.
# En el restaurante agrega la IP del servidor en la red local, por ejemplo:
#   DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Dirección completa desde la que se envían los formularios cuando no es localhost:
#   DJANGO_CSRF_ORIGINS=http://192.168.1.10:8000
DJANGO_CSRF_ORIGINS=

# 1 = forzar HTTPS (solo con un certificado válido). En la red interna por HTTP déjalo en 0.
DJANGO_HTTPS=0

# Base de datos SQLite. Por defecto es db.sqlite3 en la raíz del proyecto.
# DB_PATH=C:/ElAmir/datos/db.sqlite3

# Respaldos (comando `python manage.py respaldar`). Conviene otro disco o una memoria USB.
# RESPALDOS_DIR=D:/RespaldosElAmir
# RESPALDOS_CONSERVAR=30

# ---- Menú digital para clientes (QR) --------------------------------------
# Dirección que llevan los QR: la que abren los teléfonos de los clientes.
#   MENU_URL_PUBLICA=http://192.168.1.10:8000
MENU_URL_PUBLICA=
# Datos del local que el menú muestra (seguir en Instagram, llamar, guardar contacto).
RESTAURANTE_TELEFONO=0414-1111222
RESTAURANTE_INSTAGRAM=comidaarabeelamir_
RESTAURANTE_DIRECCION=Calle Bolívar, Puerto La Cruz, Anzoátegui
# WhatsApp: dígitos con código de país (vacío oculta el botón).
RESTAURANTE_WHATSAPP=584141111222

# ---- Asistente con IA del menú -----------------------------------------------
# Sin claves funciona igual con el asistente local. Con una clave usa ese modelo.
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
# Groq (Llama):              https://console.groq.com/keys
# xAI (Grok):                https://console.x.ai
IA_PROVEEDOR=
GEMINI_API_KEY=
# Varios modelos separados por coma: si uno está saturado se usa el siguiente.
# GEMINI_MODELO=gemini-flash-lite-latest,gemini-flash-latest
GROQ_API_KEY=
# GROQ_MODELO=llama-3.3-70b-versatile
XAI_API_KEY=
# XAI_MODELO=grok-3-mini
IA_MENSAJES_POR_HORA=30

# Umbrales de la pantalla de cocina (minutos)
KDS_MINUTOS_ALERTA=15
KDS_MINUTOS_CRITICO=25

# ---- Impuestos (los precios de la carta ya incluyen el IVA) ----
IVA_PORCENTAJE=16
IGTF_PORCENTAJE=3
# Métodos que pagan IGTF (DIV = divisa en efectivo; agrega BIN,ZIN si el contador lo indica)
IGTF_METODOS=DIV
RESTAURANTE_RIF=

# ---- Correo para enviar las facturas (vacío = se muestran en la consola, sin enviar) ----
# Brevo gratis (300/día): crea la cuenta, verifica un remitente y genera una clave SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Comida Árabe El Amir <tu-correo-verificado@ejemplo.com>

# Carpeta privada de comprobantes de pago (no se publica en /media/)
# PRIVADO_ROOT=

# Nota de cierre de caja: a qué correos se envía al generar el cierre (separados por coma).
# Si se deja vacío, se envía a los administradores que tengan correo en su usuario.
# Con Resend en modo de prueba solo llega al correo dueño de la cuenta de Resend.
CIERRE_CORREOS=
# Encabezado de la factura (opcional; estos son los valores por defecto)
# RESTAURANTE_RAZON_SOCIAL=COMIDA ARABE EL AMIR, C.A
# RESTAURANTE_DIRECCION_FISCAL=Calle Bolivar Local Nro 133|Sector Centro|Puerto La Cruz - Edo Anzoategui
