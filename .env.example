# Copia este archivo como `.env` (está en .gitignore) y ajusta los valores.
# Sin `.env` el proyecto arranca en modo desarrollo.

# 1 = desarrollo, 0 = producción
DJANGO_DEBUG=1
# Obligatoria cuando DJANGO_DEBUG=0. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 1 = forzar HTTPS y HSTS (solo en producción, con certificado válido)
DJANGO_HTTPS=0

# PostgreSQL (opcional; recomendado en producción)
# DB_ENGINE=postgresql
# DB_NAME=resto
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Umbrales de la pantalla de cocina (minutos)
KDS_MINUTOS_ALERTA=15
KDS_MINUTOS_CRITICO=25
